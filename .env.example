# openrouter | nvidia
LLM_PROVIDER=nvidia

# OpenRouter (Anthropic Messages) — used when LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api

# NVIDIA NIM (OpenAI-compatible) — used when LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Leave MODEL empty to use the provider-specific names.
MODEL=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
THINKING_LEVEL=medium
MAX_TOKENS=50000
TOP_P=0.95
LLM_TIMEOUT_SEC=600

# Generation loop
MAX_CANDIDATES=3
MAX_REPAIRS=3
WORKERS=1

# CUDA compile (leave CUDA_ARCH / GPU_NAME empty to auto-detect)
CUDA_ARCH=
GPU_NAME=
CUDA_HOME=/usr/local/cuda-12.6
NVCC_TIMEOUT_SEC=60
REPAIR_ERROR_MAX_CHARS=6000
# simple = only last solution.cu per question; detailed = all c*/r* attempts
WORK_KEEP=simple


