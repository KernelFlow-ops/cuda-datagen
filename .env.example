# OpenRouter (Anthropic Messages)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api
MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
THINKING_LEVEL=medium
MAX_TOKENS=16384
LLM_TIMEOUT_SEC=600

# Generation loop
MAX_CANDIDATES=3
MAX_REPAIRS=3

# CUDA compile (leave CUDA_ARCH / GPU_NAME empty to auto-detect)
CUDA_ARCH=
GPU_NAME=
CUDA_HOME=/usr/local/cuda-12.6
NVCC_TIMEOUT_SEC=60

# Optional OpenRouter ranking headers
HTTP_REFERER=https://github.com/cuda-datagen
X_TITLE=cuda-datagen
