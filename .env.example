# openrouter | nvidia  (single-provider fallback)
LLM_PROVIDER=nvidia
# comma-separated; with WORKERS_PER_PROVIDER runs both in parallel
LLM_PROVIDERS=
WORKERS_PER_PROVIDER=0

# OpenRouter (Anthropic Messages) — used when LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api

# NVIDIA NIM (OpenAI-compatible) — used when LLM_PROVIDER=nvidia
# Up to 3 keys (or comma-separated in NVIDIA_API_KEY). Each key is its own
# nvidia slot; with WORKERS_PER_PROVIDER=N you get N workers per key.
NVIDIA_API_KEY=
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Leave MODEL empty to use the provider-specific names.
MODEL=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
THINKING_LEVEL=medium
MAX_INPUT_TOKENS=131072
MAX_OUTPUT_TOKENS=50000
MAX_TOKENS=50000
TOP_P=0.95
LLM_TIMEOUT_SEC=600

# Generation loop
MAX_CANDIDATES=3
MAX_REPAIRS=3
WORKERS=1

# Judge Agent (code quality analysis)
JUDGE_ENABLED=true
USE_JUDGE_OPTIMIZATION=false

# Async LLM (speculative repair generation during compile)
ASYNC_LLM_ENABLED=true
ASYNC_LLM_MAX_WORKERS=2

# CUDA compile (leave CUDA_ARCH / GPU_NAME empty to auto-detect)
CUDA_ARCH=
GPU_NAME=
CUDA_HOME=/usr/local/cuda-12.6
NVCC_TIMEOUT_SEC=60
REPAIR_ERROR_MAX_CHARS=6000
# simple = only last solution.cu per question; detailed = all c*/r* attempts
WORK_KEEP=simple


